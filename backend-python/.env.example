# ── Backend Environment Variables ──
# Copy this file to .env and fill in the values

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamma_exposure

# ── External APIs ──
GEMINI_API_KEY=

# ── Indian Broker (Dhan) ──
# Get your credentials from https://api.dhan.co
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
# Optional: for token auto-renewal fallback
DHAN_PASSWORD=
DHAN_TOTP_SECRET=

# ── Indian Market GEX Tuning ──
# FII blending factor for dealer weight calculation (dynamically calculated via Method 1 with 0.65 fallback)
DEALER_ALPHA=0.65

# ── Ticker Configuration ──
# Comma-separated tickers for each market
US_TICKERS=SPX,GLD,TSLA
INDIA_TICKERS=NIFTY,BANKNIFTY,SENSEX

# ── Data Collection ──
COLLECT_INTERVAL_MINUTES=5
NSE_MAX_EXPIRIES=all

# ── Server ──
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# ── Cron Job Switches (Set to ON or OFF) ──
# 1. Option Snapshots Scraping (Every 5 minutes)
CRON_OPTION_SNAPSHOTS_ENABLED=OFF
CRON_US_OPTIONS_ENABLED=OFF
CRON_INDIA_OPTIONS_ENABLED=ON

# 2. Risk-free interest rates updater (US macro rates)
CRON_INTEREST_RATES_ENABLED=OFF

# 3. CFTC Commitments of Traders (COT) report (US positions)
CRON_COT_REPORT_ENABLED=ON

# 4. NSE Participant-Wise Open Interest (India EOD FII/Pro positions)
CRON_NSE_PARTICIPANT_ENABLED=ON

# 5. Dhan Token Renewal (India broker auth)
CRON_DHAN_TOKEN_RENEWAL_ENABLED=ON

# 6. US Market EOD daily spot history
CRON_US_EOD_ENABLED=OFF

